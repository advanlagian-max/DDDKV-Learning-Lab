{
  "name": "dkv-learning-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DKV Learning Lab — media pembelajaran interaktif Dasar-Dasar DKV Kelas X SMK (SMKN 3 Kuningan)",
  "scripts": {
    "build": "vite build",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js",
    "seed": "node server/seed.js --reset",
    "test:api": "node server/test-api.js",
    "test:ui": "esbuild tools/ui-entry.tsx --bundle --format=iife --platform=browser --outfile=/tmp/app-iife.js --loader:.tsx=tsx --jsx=automatic --define:process.env.NODE_ENV='\"production\"' && node tools/ui-smoke.mjs",
    "test": "npm run test:api && npm run test:ui",
    "audit:api": "node tools/audit-api.mjs",
    "audit:ui": "node tools/audit-ui.mjs",
    "audit": "npm run audit:api && npm run audit:ui",
    "backup": "node tools/backup-db.mjs",
    "impor:akun": "node tools/impor-akun.mjs",
    "uji:online": "node tools/uji-online.mjs",
    "uji:bingkai": "node tools/uji-bingkai.mjs",
    "uji:impor": "node tools/uji-impor-ui.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
